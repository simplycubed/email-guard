{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "noEmit": true,
    // Workers types supply the platform `fetch` the client binds; node types are
    // for the test suite and the scanner only. Neither reaches the PUBLIC surface:
    // every exported type is structural (FetchLike / FetchResponseLike), so a
    // consumer is never forced into either lib.
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "test", "*.ts", "scripts"]
}
